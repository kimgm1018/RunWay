# 로컬에서 백엔드를 직접 실행할 때 사용하는 예시다.
# 앱/Swagger로 공유 서버만 호출하는 개발자는 이 파일을 설정할 필요가 없다.
# 실제 값은 사용자가 로컬에서 입력하고, IntelliJ 또는 실행 터미널의 환경변수로 주입한다.
# Spring Boot는 .env 파일을 자동으로 읽지 않는다.

# 서버 필수. URL에 사용자 이름/비밀번호를 넣으면 기동을 거부한다.
BACKEND_DB_URL=jdbc:postgresql://localhost:5432/runway
BACKEND_DB_USERNAME=runway_dev
# 필수 Secret. 빈 값으로는 실행할 수 없다.
BACKEND_DB_PASSWORD=

# 개발 DB Compose 전용. URL의 DB 이름/포트와 일치시킨다.
BACKEND_DB_NAME=runway
BACKEND_DB_PORT=5432

# 서버 선택 설정. 기본은 로컬 컴퓨터에서만 접근 가능하다. 빈 값은 허용하지 않는다.
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8080

# 로컬 백엔드 실행 시 필수 Secret. 최소 32바이트 난수를 Base64로 인코딩한다.
# 공유 서버의 키를 복사하지 않고 로컬용 키를 별도로 생성한다. 빈 값으로는 기동하지 않는다.
BACKEND_JWT_SECRET_BASE64=

# 로컬 루프백에서는 Swagger 문서 전용 계정 없이 사용한다.
BACKEND_DOCS_ACCESS_MODE=local

# 아래는 공유 서버 전용 안내다. 로컬 실행에는 설정하지 않는다.
# 인프라 담당자가 서버용 JWT 키와 문서 계정을 Secret 설정에 등록하고 컨테이너에 주입한다.
# BACKEND_JWT_SECRET_BASE64=<서버용 키를 Secret 저장소에서 주입>
# BACKEND_DOCS_ACCESS_MODE=password
# BACKEND_DOCS_USERNAME=
# {bcrypt} 접두사가 붙은 BCrypt 해시. 원문 및 해시 모두 Git/로그에 남기지 않는다.
# BACKEND_DOCS_PASSWORD_HASH=
