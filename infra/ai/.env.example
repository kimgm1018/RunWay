# Compose 실행용 예시. 실제 .env는 Git에 올리지 않는다.
# 아래 파일을 AI_IMAGE, AI_MODEL_FILE, HR_MODEL_SHA256 환경변수 설정에 참고한다.
# 검증한 이미지의 버전 태그를 명시한다.
AI_IMAGE=runway-ai:<version>
# EC2에 준비한 모델 파일의 절대 경로. UID 10001이 읽을 수 있어야 한다.
AI_MODEL_FILE=/home/ubuntu/runway/models/gru/<version>/gru_final.pt
# 선택한 파일에 대해 AI팀이 제공한 SHA-256 (64자리)을 지정한다.
HR_MODEL_SHA256=
