<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- Daily HR: API 36+ health permissions; BODY_SENSORS pair only up to API 35. -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />
    <uses-permission android:name="android.permission.BODY_SENSORS" android:maxSdkVersion="35" />
    <uses-permission android:name="android.permission.BODY_SENSORS_BACKGROUND" android:maxSdkVersion="35" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- S15P31E105-311: keeps the run process alive while batches are recorded and sent. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <!-- Readiness: follow the watch's default network before a run (S15P31E105-265). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- S15P31E105-257: rhythm BPM cue vibrates on every beat while running. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/RunwayWatchTheme">
        <uses-library
            android:name="com.google.android.wearable"
            android:required="true" />

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/RunwayWatchTheme.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".session.RunForegroundService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <service
            android:name=".dailyhr.PassiveHrService"
            android:exported="true"
            android:permission="com.google.android.wearable.healthservices.permission.PASSIVE_DATA_BINDING" />

        <service
            android:name=".dailyhr.WatchDataLayerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/runway/v1/health/"
                    android:scheme="wear" />
                <!-- S15P31E105-256: run-session commands relayed by the phone, and its errors. -->
                <data
                    android:host="*"
                    android:pathPrefix="/runway/v1/session/"
                    android:scheme="wear" />
                <!-- S15P31E105-311: BATCH_RECEIVED / BATCH_COMMITTED for the watch's measurement batches. -->
                <data
                    android:host="*"
                    android:pathPrefix="/runway/v1/data/"
                    android:scheme="wear" />
                <!-- S15P31E105-257: COACHING_GUIDE approved by the server and relayed by the phone. -->
                <data
                    android:host="*"
                    android:pathPrefix="/runway/v1/coaching/"
                    android:scheme="wear" />
                <!-- S15P31E105-420: GROUP_STATUS, the G10 group standing relayed by the phone. -->
                <data
                    android:host="*"
                    android:pathPrefix="/runway/v1/group/"
                    android:scheme="wear" />
                <data
                    android:host="*"
                    android:path="/runway/v1/error"
                    android:scheme="wear" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/runway/v1/state/"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <receiver
            android:name=".dailyhr.DailyHrBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
