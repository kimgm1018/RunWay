// 처음에는 트리거 없이 수동으로 이미지 빌드만 확인한다.
// 검증 후 Jenkins의 Push Events·브랜치 필터를 master로 설정하면 master Push에 자동 배포한다.

pipeline {
    agent { label 'backend' }

    options {
        // Checkout 단계를 직접 제어하고, 이 CD 작업의 동시 실행을 막는다.
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20', artifactNumToKeepStr: '5'))
    }

    parameters {
        // SCM은 Jenkins에 설정한 브랜치 그대로 검사한다. 실제 배포는 master만 허용한다.
        choice(name: 'SOURCE_BRANCH', choices: ['SCM', 'dev', 'master'], description: 'SCM: Jenkins에 설정한 브랜치, dev/master: 해당 브랜치로 빌드')
        booleanParam(name: 'DEPLOY', defaultValue: false, description: 'master를 실제 배포한다. 체크하지 않으면 이미지 빌드까지만 실행')
    }

    stages {
        // 코드를 받기 전에 이번 실행이 빌드 확인인지 실제 배포인지 결정한다.
        stage('Select Mode') {
            steps {
                script {
                    if (env.gitlabMergeRequestIid) {
                        error('MR 검사는 runway-ci에서 실행합니다.')
                    }
                    def automatic = env.gitlabActionType == 'PUSH'
                    if (automatic && env.gitlabBranch != 'master') {
                        error('자동 배포는 master Push만 허용합니다.')
                    }
                    def source = automatic ? 'master' : (params.SOURCE_BRANCH ?: 'SCM')
                    if (!(source in ['SCM', 'dev', 'master'])) {
                        error('SCM, dev 또는 master만 선택할 수 있습니다.')
                    }
                    if (params.DEPLOY && source != 'master') {
                        error('실제 배포는 SOURCE_BRANCH에서 master를 직접 선택해야 합니다.')
                    }
                    env.CD_SOURCE_BRANCH = source
                    env.CD_DEPLOY = (automatic || params.DEPLOY) ? 'true' : 'false'
                    echo "대상 브랜치: ${source}, 실제 배포: ${env.CD_DEPLOY}"
                }
            }
        }

        // 선택한 브랜치를 전용 작업 폴더로 받는다. CI 작업 폴더나 EC2 배포 폴더는 정리하지 않는다.
        stage('Checkout') {
            steps {
                deleteDir()
                script {
                    if (env.CD_SOURCE_BRANCH == 'SCM') {
                        // 파이프라인을 읽은 작업 브랜치를 빌드해 병합 전에도 검증할 수 있다.
                        checkout scm
                    } else {
                        checkout([
                            $class: 'GitSCM',
                            branches: [[name: "refs/remotes/origin/${env.CD_SOURCE_BRANCH}"]],
                            userRemoteConfigs: [[
                                url: 'https://lab.ssafy.com/s15-final/S15P31E105.git',
                                credentialsId: 'runway-gitlab-repo',
                                refspec: '+refs/heads/*:refs/remotes/origin/*'
                            ]]
                        ])
                    }
                    def sha = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
                    if (!(sha ==~ /[0-9a-f]{40}/)) {
                        error('배포 코드의 커밋 번호를 확인할 수 없습니다.')
                    }
                    // 커밋과 빌드 번호로 구분해 기존 이미지의 태그를 덮어쓰지 않는다.
                    env.BACKEND_IMAGE = "runway-backend:${sha.take(12)}-${env.BUILD_NUMBER}"
                }
            }
        }

        // 검사·테스트 실패 시 JAR·이미지·배포 단계로 진행하지 않는다.
        stage('Backend Checks and Tests') {
            steps {
                script {
                    try {
                        dir('backend') {
                            sh 'sh ./gradlew --no-daemon clean check'
                        }
                    } finally {
                        // 실패 보고서도 남기고, JUnit 실패는 배포 전에 차단한다.
                        def results = junit(allowEmptyResults: true,
                            testResults: 'backend/build/test-results/test/*.xml')
                        if (results && results.failCount > 0) {
                            error('테스트 보고서에 실패가 있습니다.')
                        }
                    }
                }
            }
        }
        // check를 반복하지 않고 실행 JAR을 생성한다.
        stage('Backend JAR Build') {
            steps {
                dir('backend') {
                    sh 'sh ./gradlew --no-daemon assemble'
                }
            }
        }

        // JAR만 빌드 컨텍스트로 전달하고 같은 EC2의 Docker 엔진에 이미지를 저장한다.
        stage('Backend Image Build') {
            steps {
                sh '''
                    set -eu
                    set -- backend/build/libs/*.jar
                    test "$#" -eq 1 && test -f "$1"
                    docker build -f infra/backend/Dockerfile \
                        -t "$BACKEND_IMAGE" backend/build/libs
                '''
                echo "생성한 이미지: ${env.BACKEND_IMAGE}"
            }
        }

        // master 배포·전후 상태 검사·실패 롤백은 기존 스크립트 안에서 함께 처리한다.
        stage('Deploy and Verify') {
            when { expression { env.CD_DEPLOY == 'true' } }
            steps {
                sh '''
                    BACKEND_API_ROUTES_FILE="$WORKSPACE/backend/build/generated/monitoring/api-routes.json" \
                    bash infra/backend/deploy.sh "$BACKEND_IMAGE" \
                        /home/ubuntu/runway/infra/backend/compose.yaml
                '''
            }
        }
        stage('Backend Archive') {
            steps {
                archiveArtifacts artifacts: 'backend/build/libs/*.jar,backend/build/generated/monitoring/api-routes.json', fingerprint: true
            }
        }
    }

    // 성공 메시지는 배포 여부와 생성한 이미지 버전을 함께 표시한다.
    post {
        success {
            echo "작업 완료. 실제 배포: ${env.CD_DEPLOY}, 이미지: ${env.BACKEND_IMAGE}"
        }
    }
}
