# RunWay AI 추론 서버 환경변수 예시. 비밀값은 없다.
# 복사해서 쓴다: cp .env.example .env  (.env는 Git에 올리지 않는다)
# 상대 경로는 ai/service/ 기준이다.

# HR 예측 모델 종류 (현재 gru)
HR_MODEL_TYPE=gru
# 체크포인트 파일 (Hugging Face doyeonkoo/runway-hr-gru의 gru_final.pt)
HR_MODEL_PATH=models/gru_final.pt
# 값을 주면 시작할 때 체크포인트 SHA256을 확인한다 (다르면 모델을 로드하지 않음)
HR_MODEL_SHA256=db59d414b8b88a6ac1140dd5bbce40475878d97a6436fb087141e25bdb3887fe
# GRU predictor 코드 폴더 (Docker에서는 이미지 안 경로로 바꾼다)
HR_GRU_SRC_DIR=../workspace/doyeon/gru/src
# cpu 또는 cuda
HR_DEVICE=cpu
# CPU 추론 스레드 수
TORCH_NUM_THREADS=4
