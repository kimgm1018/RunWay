# 로컬 AI 서비스 환경 예시. 상대 경로는 ai/service/ 기준이며 비밀값은 없다.
# 운영 배포는 infra/ai/compose.yaml이 컨테이너 경로를 설정한다.

# 러닝 중 HR 예측·판단: 독립 GRU M3-005
HR_MODEL_TYPE=gru
HR_MODEL_PATH=models/gru_final.pt
HR_MODEL_SHA256=db59d414b8b88a6ac1140dd5bbce40475878d97a6436fb087141e25bdb3887fe
HR_GRU_SRC_DIR=../workspace/doyeon/gru/src
HR_DEVICE=cpu
TORCH_NUM_THREADS=1
MPC_MARGIN_TABLE_PATH=app/policy/data/margin_gru.json
# 자유러닝(history 경사 전부 null): reject(팀 기존 계약) | unknown | flat0(기본값, 0% 평지)
FREE_RUN_GRADE_POLICY=flat0
# 개인 계획용 팀 DB 읽기 전용 접속(실제 값은 커밋하지 않는다). 비우면 개인 계획은 503.
AI_DB_URL=
GRU_PERSONALIZATION_ENABLED=false
GRU_PERSONALIZATION_MAX_WINDOWS=2000
GRU_PERSONALIZATION_CACHE_TTL_SEC=300
GRU_PERSONALIZATION_EMPTY_CACHE_TTL_SEC=60
GRU_PERSONALIZATION_CACHE_MAX_USERS=1024
GRU_PERSONALIZATION_DB_TIMEOUT_MS=300
# 무거운 요청 대기열은 두 줄이다. 계획(AI05·AI09)과 개인화(AI06)가 서로 기다리지 않는다.
# 각 줄은 기본 한 번에 하나씩 실행하고, 최대 30초 기다린 뒤 넘으면 503 AI_BUSY다.
# 두 줄이 동시에 돌면 메모리 최고치가 늘 수 있다(ODE 계획 + ODE 개인화). mem_limit을 함께 본다.
HEAVY_MAX_CONCURRENCY=1
HEAVY_PERSONALIZE_MAX_CONCURRENCY=1
HEAVY_QUEUE_WAIT_SEC=30
PERSONAL_PLAN_EXPERIMENTAL_ENABLED=false
# 개인 계획 탐색 계산 예산(ODE 30초 rollout 칸 총수). 넘는 긴 코스만 탐색을 줄이고 PLAN_SEARCH_BUDGET_LIMITED 경고.
PERSONAL_PLAN_SEARCH_BUDGET_CELLS=70000
# 첫 1 km가 나머지 평균보다 빠르면 첫 km만 평균으로 올림(기본 true, 탐색 뒤 후처리). 바뀌면 PLAN_FIRST_SEGMENT_CAPPED 경고.
PLAN_FIRST_SEGMENT_NO_FASTER_THAN_MEAN=true
# 팀원 HR 모델을 붙일 때만: HR_MODEL_TYPE=<계열>, HR_MODEL_PLUGIN=<모듈:팩토리>, HR_MODEL_PLUGIN_DIR=<폴더>
# 그 계열의 MPC 여유 표(model 필드가 같은 계열)도 MPC_MARGIN_TABLE_PATH로 지정해야 AI04가 동작한다.
HR_MODEL_PLUGIN=
HR_MODEL_PLUGIN_DIR=

# 출발 전 계획/선택 미리보기와 개인화: CNN encoder를 포함한 ODE v2.1 1차 base epoch020
ODEV21_CHECKPOINT_PATH=models/ode/ode_epoch_020.pt
ODEV21_CHECKPOINT_SHA256=ba767a645c2b1180a3ced3cbcc533142544d3e34cc69b23aed28eba134b14061
ODEV21_SUMMARY_STATS_PATH=models/ode/ode_summary_stats.json
ODEV21_SUMMARY_STATS_SHA256=9251e04e3dc50ecb66cbd48faa7c6882b80f16a51af0746669cd5f0545b4e066
# 신규 사용자 평균 묶음(V2 Train 545명 사람별 중앙값). 파일은 저장소에 넣지 않고 모델처럼 받는다.
ODEV21_POPULATION_BUNDLE_PATH=models/ode/population_bundle_v2train_median.json
ODEV21_POPULATION_BUNDLE_SHA256=9dcb5f4c2aa7281de732b4a5fe64fb658f8acebc9f1b35389a71a7fe2b877ef1
# median_bundle(기본) | empty(G0: P4·history·요약 비움) | off(평균 계획 없음, 503)
PERSONAL_PLAN_POPULATION_MODE=median_bundle
ODEV21_VARIANT=ode_v21_base_epoch20_legacy27
ODEV21_DEVICE=cpu
ODEV21_TORCH_THREADS=1
ODEV21_WARMUP_ENABLED=true
# ODE 검증 지평(90분): AI02 보고·HR 미리보기 범위. 개인 계획 상한은 없고 90분 넘으면 경고만(MVP 후 점검).
ODEV21_VALIDATED_HORIZON_SEC=5400
ODEV21_P4_LR=0.03
ODEV21_P4_LAMBDA=1.0
ODEV21_P4_STEPS=100

# 안전 기본값: 기능은 앱/Compose 모두 OFF. 운영 검증을 위해 켤 때만 true로 변경한다.
ODE_PREVIEW_ENABLED=false
DECIDE_FORECAST_ENABLED=false
DEMO_STREAM_ENABLED=false
# demo 토큰은 기능을 명시적으로 쓸 때 로컬에서만 생성한다. 실제 값은 커밋하지 않는다.
DEMO_VIEW_TOKEN=
DEMO_INGEST_TOKEN=
DEMO_CONFIG_PATH=
