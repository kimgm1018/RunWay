<resources>

    <!-- Running pages are swiped sideways, so the system swipe-to-dismiss is off; WatchApp re-enables
         swipe-to-close only outside a run. -->
    <style name="RunwayWatchTheme" parent="@android:style/Theme.DeviceDefault">
        <item name="android:windowSwipeToDismiss">false</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="RunwayWatchTheme.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/RunwayWatchTheme</item>
    </style>
</resources>
