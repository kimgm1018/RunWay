# 로컬에서 백엔드를 직접 실행할 때 사용하는 예시다.
# 앱/Swagger로 공유 서버만 호출하는 개발자는 이 파일을 설정할 필요가 없다.
# 실제 값은 사용자가 로컬에서 입력하고, IntelliJ 또는 실행 터미널의 환경변수로 주입한다.
# Spring Boot는 .env 파일을 자동으로 읽지 않는다.

# 서버 필수. URL에 사용자 이름/비밀번호를 넣으면 기동을 거부한다.
BACKEND_DB_URL=jdbc:postgresql://localhost:5432/runway
BACKEND_DB_USERNAME=runway_dev
# 필수 Secret. 빈 값으로는 실행할 수 없다.
BACKEND_DB_PASSWORD=

# 개발 DB Compose 전용. URL의 DB 이름/포트와 일치시킨다.
BACKEND_DB_NAME=runway
BACKEND_DB_PORT=5432

# 로그인 서버·Redis Compose 필수. 실제 비밀번호는 사용자가 로컬에 입력한다.
BACKEND_REDIS_HOST=127.0.0.1
BACKEND_REDIS_PORT=6379
BACKEND_REDIS_USERNAME=runway_app
BACKEND_REDIS_PASSWORD=
# 로컬 루프백/동일 신뢰 내부망 전용. 신뢰 경계를 통과하면 인증서 검증 TLS를 사용한다.
BACKEND_REDIS_SSL_ENABLED=false

# 서버 선택 설정. 기본은 로컬 컴퓨터에서만 접근 가능하다. 빈 값은 허용하지 않는다.
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8080

# 서버 선택. DB 대기 상한(정수). 비워 두지 말고 바꾸지 않을 때는 줄을 지우거나 주석 처리한다. 근거는 backend/README.md 참고.
# BACKEND_DB_CONNECTION_TIMEOUT_MS=5000
# BACKEND_DB_LOCK_TIMEOUT_MS=5000
# BACKEND_DB_STATEMENT_TIMEOUT_MS=10000
# BACKEND_DB_SOCKET_TIMEOUT_S=15

# 로컬 백엔드 실행 시 필수 Secret. 최소 32바이트 난수를 Base64로 인코딩한다.
# 공유 서버의 키를 복사하지 않고 로컬용 키를 별도로 생성한다. 빈 값으로는 기동하지 않는다.
BACKEND_JWT_SECRET_BASE64=

# 로컬 루프백에서는 Swagger 문서 전용 계정 없이 사용한다.
BACKEND_DOCS_ACCESS_MODE=local

# F01 이미지 볼륨 저장. 상대 경로는 프로세스 작업 디렉터리 기준이다. 최대 크기는 5MB로 코드·multipart 설정에 고정한다.
BACKEND_IMAGE_VOLUME_PATH=data/images

# C01 코스 생성(Route). 비우면 서버는 기동하지만 코스 추천이 503(ROUTE_UNAVAILABLE)이다.
# Route 서버 없이 앱 화면을 확인하려면 stub으로 바꾼다. stub은 개발용 가짜 경로·경사를 반환하며 서버에는 쓰지 않는다.
BACKEND_ROUTE_MODE=http
# Route 전용 내부 origin만 입력한다(예: http://127.0.0.1:8000). 경로·쿼리·사용자 정보는 넣지 않는다.
BACKEND_ROUTE_BASE_URL=

# C01 경사 계산용 DEM clip(GeoTIFF) 경로. 비우거나 파일 해시가 맞지 않으면 코스 추천이 503(GRADE_NOT_READY)이다.
# 파일은 AI 팀 비공개 HF 저장소에서 받는다(backend/README.md 9절, 접근 권한 필요). stub 모드에서 비우면 개발용 합성 고도를 쓴다.
BACKEND_COURSE_DEM_PATH=
# 선택. 기본값은 공유된 부산 DEM의 SHA-256(45faaa5e36c7…)이다. 다른 파일을 검증할 때만 바꾼다.
# BACKEND_COURSE_DEM_SHA256=

# HR 추론 AI 서버(ai/service) 내부 origin만 입력한다(예: http://127.0.0.1:8000). AI04 실시간 코칭, AI06 심박 개인화,
# AI05 코스 구간 난이도 비율 계산이 함께 쓴다. 코스 추천(Route)은 별도 컨테이너로 BACKEND_ROUTE_BASE_URL을 쓴다.
# 비우면 서버는 기동하지만 자동 코칭을 하지 않고, 개인화 호출이 실패해 저장하지 않으며, 코스 구간 비율을 계산하지 않는다(세션 계획은 균등 분배).
BACKEND_AI_BASE_URL=

# 아래는 공유 서버 전용 안내다. 로컬 실행에는 설정하지 않는다.
# 인프라 담당자가 서버용 JWT 키와 문서 계정을 Secret 설정에 등록하고 컨테이너에 주입한다.
# BACKEND_JWT_SECRET_BASE64=<서버용 키를 Secret 저장소에서 주입>
# BACKEND_DOCS_ACCESS_MODE=password
# BACKEND_DOCS_USERNAME=
# {bcrypt} 접두사가 붙은 BCrypt 해시. 원문 및 해시 모두 Git/로그에 남기지 않는다.
# BACKEND_DOCS_PASSWORD_HASH=

# Optional: comma-separated trusted reverse proxy IP/CIDR values. Empty ignores forwarded headers.
BACKEND_AUTH_TRUSTED_PROXIES=
