JIRA_PROJECT_KEY=S15P31E105
JIRA_BOARD_ID=16659
JIRA_EMAIL=
JIRA_API_TOKEN=
# Optional: for a scoped token, use the gateway while keeping BASE_URL above.
# JIRA_API_BASE_URL=https://api.atlassian.com/ex/jira/15a21def-11f5-4358-ab48-074194685963
# Optional override when more than one story-points field is available:
# JIRA_STORY_POINTS_FIELD=customfield_10031

# Optional GitLab API settings. Enter your personal token only in LOCAL .env.
GITLAB_BASE_URL=https://lab.ssafy.com
GITLAB_PROJECT_ID=1457097
GITLAB_API_TOKEN=

# Android Naver Map Client ID (ADR-0018, frontend/README.md). Not a secret: it ships in the APK.
# Gradle does not read .env: put the value in frontend/android/local.properties or the same-named environment variable.
MOBILE_NAVER_MAP_CLIENT_ID=
