# Compose interpolation 예시. 실제 .env와 인증정보는 Git에 올리지 않는다.
# deploy.sh는 Compose에 --env-file /dev/null을 지정한다. 실행 전에 이 값들을 배포 환경으로 export한다.
# 역할: GRU M3-005는 AI03/04 러닝 중 예측·판단, ODE v2.1 1차 base epoch020은 AI05 계획/HR preview와 AI06 개인화.
# CNN encoder는 ODE runtime 안에 포함된다. 모델 weight는 이미지에 넣지 않는다.
# 기본 모델 다운로드는 비공개 HF 저장소를 사용한다. HF_TOKEN은 읽기 권한 credential로 주입하고 Jenkins에서는 Jenkins credential binding을 쓴다.
# HF_TOKEN 값은 이 예시 파일이나 실제 .env에 저장하지 않는다. 서비스의 scripts/fetch_models.*는 ODEV21_SOURCE_MODE=local일 때 HF_TOKEN 없이 로컬 ODE 파일을 복사할 수 있다.
AI_IMAGE=runway-ai:replace-with-approved-tag

# 호스트 절대경로. deploy.sh는 AI_MODEL_DIR을 AI_MODEL_FILE의 부모로 설정한다.
# GRU·ODE checkpoint·stats·평균 bundle 파일 4개를 같은 호스트 디렉터리에 둔다.
AI_MODELS_ROOT=/home/ubuntu/runway/models/releases
AI_MODEL_FILE=/home/ubuntu/runway/models/replace-with-approved-tag/gru_final.pt
AI_MODEL_DIR=/home/ubuntu/runway/models/replace-with-approved-tag
# test-artifacts/gru_final.pt (독립 GRU M3-005)
HR_MODEL_SHA256=db59d414b8b88a6ac1140dd5bbce40475878d97a6436fb087141e25bdb3887fe
# test-artifacts/ode_epoch_020.pt (ODE v2.1 1차 base epoch020; CNN encoder 포함)
ODEV21_CHECKPOINT_PATH=/models/ode/ode_epoch_020.pt
ODEV21_CHECKPOINT_SHA256=ba767a645c2b1180a3ced3cbcc533142544d3e34cc69b23aed28eba134b14061
# test-artifacts/ode_summary_stats.json
ODEV21_SUMMARY_STATS_PATH=/models/ode/ode_summary_stats.json
ODEV21_SUMMARY_STATS_SHA256=9251e04e3dc50ecb66cbd48faa7c6882b80f16a51af0746669cd5f0545b4e066
ODEV21_POPULATION_BUNDLE_PATH=/models/ode/population_bundle_v2train_median.json
ODEV21_POPULATION_BUNDLE_SHA256=9dcb5f4c2aa7281de732b4a5fe64fb658f8acebc9f1b35389a71a7fe2b877ef1
PERSONAL_PLAN_POPULATION_MODE=median_bundle
ODEV21_VARIANT=ode_v21_base_epoch20_legacy27
ODEV21_DEVICE=cpu
ODEV21_TORCH_THREADS=1
ODEV21_WARMUP_ENABLED=true
ODEV21_VALIDATED_HORIZON_SEC=5400
ODEV21_VALIDATION_REF=
ODEV21_P4_LR=0.03
ODEV21_P4_LAMBDA=1.0
ODEV21_P4_STEPS=100
# prepare_db.py가 EC2에서 준비한 Secret 파일. 실제 URL·비밀번호는 예시에 넣지 않는다.
AI_DB_URL_FILE=/home/ubuntu/runway/secrets/ai/db-url
GRU_PERSONALIZATION_ENABLED=false
GRU_PERSONALIZATION_MAX_WINDOWS=2000
GRU_PERSONALIZATION_CACHE_TTL_SEC=300
GRU_PERSONALIZATION_EMPTY_CACHE_TTL_SEC=60
GRU_PERSONALIZATION_CACHE_MAX_USERS=1024
GRU_PERSONALIZATION_DB_TIMEOUT_MS=300
# 계획(AI05·AI09) 줄과 개인화(AI06) 줄의 동시 실행 수. 대기 한도(초)는 두 줄 공통.
HEAVY_MAX_CONCURRENCY=1
HEAVY_PERSONALIZE_MAX_CONCURRENCY=1
HEAVY_QUEUE_WAIT_SEC=30

# 안전 기본값은 OFF. 실제 검증할 때만 배포 환경에서 true로 설정한다.
PERSONAL_PLAN_EXPERIMENTAL_ENABLED=false
ODE_PREVIEW_ENABLED=false
DECIDE_FORECAST_ENABLED=false
# 이미지 안 기본 margin table을 사용한다.
MPC_MARGIN_TABLE_PATH=
