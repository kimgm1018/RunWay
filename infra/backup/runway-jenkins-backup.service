[Unit]
Description=Encrypt completed RunWay Jenkins configuration backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/lib/runway-backup/jenkins_backup.py --key-file /root/runway-backup-key
TimeoutStartSec=1h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
